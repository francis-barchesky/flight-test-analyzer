{
  "_comment": "Batch config for pipeline.sh / run_batch.py — generated by iads-query skill",

  "script": "analyze_iads.py",

  "data_root": ".",

  "output_dir": null,

  "download_script": "~/Documents/GitHub/iads-export/scripts/iads_export_manual_multiple_download.sh",
  "download_start_date": "2026-04-21",
  "download_end_date":   "today",
  "_comment_download_pattern": "Regex(es) matched against S3 keys. String or array of regexes; arrays become an OR alternation. Only ZIPs with signals used for plots/analysis are kept; the rest are listed in exclude_zip_patterns below and would just be downloaded then ignored.",
  "download_pattern":    ["AFCS_del", "AFCS_MiscAnalysis"],

  "trigger":       "afcsCapable",
  "trigger_from":  1.0,
  "trigger_to":    0.0,

  "workers": 22,
  "parallel_sorties": 2,

  "plot_signals": "atSatTorqueCmd,yawServoTorqueFilt,throttleServoTorqueFilt,rollServoTorqueFilt,pitchServoTorqueFilt,torqueVoted,radAltVoted,gndSpdVoted,latDevSel,vertDevSel,GNSS_Latitude,GNSS_Latitude_Fine,GNSS_Longitude,GNSS_Longitude_Fine,casVoted,pfdCasTarget,pitchAngleVoted,rollAngleVoted,fgPitchCmd,fgRollCmd,flapAngleVoted,magHeadingVoted,vertAccelFilt,vertAccelUnfilt,selValue,aptTrimRateServoCmd,afcsEngageEnum,landConfigFail,landFail,lpvApprFail,takeoffConfigFail,lnavModeFail,gpsApprIntegrityValid,gpsApprAnnun,apprLatDevValid",

  "skip_existing": true,

  "exclude_zip_patterns": [
    "SYS_parameters",
    "HW_RdcParameters",
    "MBD_FccVersion",
    "AFCS_SlipClutch",
    "AFCS_StatusValidAssessment",
    "MBD_InputProcessing"
  ],

  "delete_zips_after": true,

